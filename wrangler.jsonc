{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khum-pos",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khum-pos",
      "database_id": "d632a3d2-81fe-45e7-9008-79252b09afc6",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "MASTER_GOOGLE_SUB": "",
    "APP_ORIGIN": "",
    "ANDROID_ORIGIN": "https://localhost"
  }
}

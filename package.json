{
  "name": "khum-pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.js && python3 tests/schema_test.py",
    "check": "node --check src/worker.js && node --check public/app.js && node --check public/core.js",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "android:prepare": "npm run build && cap add android && cap sync android && node scripts/android-config.mjs",
    "android:sync": "npm run build && cap sync android && node scripts/android-config.mjs",
    "build": "esbuild scripts/native-entry.js --bundle --format=esm --minify --outfile=public/native.js",
    "dev:wrangler": "wrangler dev"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.0.0"
  }
}
